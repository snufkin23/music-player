<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio library access -->
    <!-- Music is read per-folder via the Storage Access Framework; no broad
         media/storage permission is requested. -->

    <!-- Foreground service base permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground service type permission (mandatory pairing, API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Media notification (lock screen, notification shade controls) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Prevent playback interruption during screen-off states -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MusicApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Musicplayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Musicplayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.MusicPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

    </application>

</manifest>